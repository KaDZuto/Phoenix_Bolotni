# ---------------------------------------------------------------------------
# Phoenix_Bolotni — серверный распознаватель. Пример переменных окружения.
#
# Скопируйте в `.env` и замените секреты:
#     cp .env.example .env
#
# ВАЖНО: `.env` не коммитится (см. `.gitignore`). Значения с пометкой «секрет»
# обязательно заменить в проде — иначе сервис либо не запустится, либо будет
# доступен посторонним.
#
# Все настройки читаются в `server/config.py`, единственный источник правды.
# ---------------------------------------------------------------------------


# --- БД (прод) -----------------------------------------------------------------

# ВАЖНО: `geohash`-аналитика на Postgres использует PostGIS (`detections.geom`),
# поэтому в `POSTGRES_DB` нужно сначала выполнить `CREATE EXTENSION postgis`
# (это делает `alembic upgrade head` и `docker compose up` автоматически).
PHOENIX_DATABASE_URL=postgresql+psycopg://phoenix:CHANGE_ME@db:5432/phoenix

# Локальная разработка и тесты — обычный SQLite, PostGIS не нужен:
# PHOENIX_DATABASE_URL=sqlite:///./server/data/phoenix.db

# Печатать все SQL-запросы. Полезно при отладке аналитики, нагружает лог.
PHOENIX_DATABASE_ECHO=false


# --- Репозиторий модели (внешняя библиотека, не копируется в этот проект) -------
# Пути ниже — для запуска ВНЕ контейнеров, где репозиторий модели лежит рядом.
# В docker-compose эти значения переопределяются на /app/model_repo/..., потому что
# репозиторий модели подключается томом на чтение (MODEL_REPO_PATH), а не
# копируется в образ: models/bird_model.onnx в git хранится указателем git-LFS,
# и COPY в образ дал бы 133-байтную заглушку вместо модели.

PHOENIX_MODEL_CONFIG=./model_config.json
PHOENIX_CLASSES=./models/classes.json
PHOENIX_WHITELIST=./species/ru_birds_whitelist.json
PHOENIX_MODEL=./models/bird_model.onnx

# В контейнере модель подключается из этого пути хоста (docker-compose).
MODEL_REPO_PATH=..

# TTA (augmentation на трёх сдвигах окна). +3–5% качества, но втрое дороже по CPU.
PHOENIX_USE_TTA=true

# Сохранять per-window предсказания для отладки (только числа, без аудио).
# В проде выключено: таблица `raw_windows` растёт примерно как поток детекций.
PHOENIX_STORE_RAW_WINDOWS=false


# --- Доступ: что публично, что за VPN -------------------------------------------
# Раздел 2 td3.md разделяет систему на публичную и приватную части. Здесь —
# токены обеих сторон.

# Токен админ-API реестра устройств (приватная сторона, за VPN).
# Обязателен в проде: без него `/api/devices` открыт на запись кому угодно.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
PHOENIX_ADMIN_TOKEN=CHANGE_ME_admin_token

# Отдельный токен только для первичной регистрации устройств.
# Если не задан — используется PHOENIX_ADMIN_TOKEN.
PHOENIX_REGISTRATION_TOKEN=CHANGE_ME_registration_token

# Basic-аутентификация дашборда и API карты.
PHOENIX_DASHBOARD_AUTH=true
PHOENIX_DASHBOARD_USER=ecologist
PHOENIX_DASHBOARD_PASSWORD=CHANGE_ME_dashboard_password

# ЛОКАЛЬНЫЙ ЗАПУСК: чтобы поднять стек без пароля, поменяйте PHOENIX_DASHBOARD_AUTH=true
# на PHOENIX_DASHBOARD_AUTH=false (docker-compose делает это сам, см. его .env).
# С `false` карта и все детекции видны любому, кто дотянется до порта, поэтому
# в проде это недопустимо: дашборд — это данные мониторинга редких видов.

# CORS для внешнего фронтенда (через запятую). Пусто = только свои origins.
PHOENIX_CORS_ORIGINS=


# --- Протокол загрузки чанков (Задача 3) ----------------------------------------

# Ожидаемая пауза между началами чанков от одного устройства, секунд.
PHOENIX_DEFAULT_EXPECTED_CHUNK_SEC=60

# Допустимая длительность чанка. Ниже — слишком короткий для 5-секундного окна
# модели, выше — слишком долгий ответ клиенту.
PHOENIX_CHUNK_MIN_SEC=20
PHOENIX_CHUNK_MAX_SEC=90

# Ожидаемое перекрытие соседних чанков, секунд. От него зависит дедупликация
# детекций на стыках: если реальное перекрытие отличается, на границах
# появятся дубли.
PHOENIX_EXPECTED_OVERLAP_SEC=5

# Потолок на размер загрузки. 32 МБ ≈ 16 минут PCM16 16 кГц, то есть с запасом.
PHOENIX_MAX_UPLOAD_BYTES=33554432

# Разрешённые форматы аудио (на входе ожидается WAV/FLAC с корректными заголовками).
PHOENIX_AUDIO_FORMATS=wav,flac,ogg,mp3,m4a

# Терпимость к рассинхрону часов устройства: чанк не может быть старше указанного
# числа секунд или «из будущего». Полевое оборудование с дешёвыми RTC дрейфует,
# но и совсем грубые часы ловят именно этот фильтр.
PHOENIX_MAX_CLOCK_SKEW_PAST_SEC=120
PHOENIX_MAX_CLOCK_AHEAD_SEC=300


# --- Очередь и память (Задачи 3–4) ----------------------------------------------

# Аудио живёт только в RAM: на диск и в БД оно не попадает никогда.
# Предел памяти под очередь: при переполнении `/ingest` честно отвечает 503,
# и устройство повторяет загрузку. Не поднимайте выше, чем реально есть на машине.
PHOENIX_SPOOL_MAX_BYTES=268435456

# TTL байтов в очереди. Аварийный клапан для зависшего воркера, а не политика хранения.
PHOENIX_SPOOL_TTL_SEC=300

# Параметры воркера. Внутри одного процесса воркер один: и очередь, и байты
# аудио живут в памяти процесса, поэтому масштабирование воркера означает
# несколько процессов, у каждого свой независимый spool (см. `server/README.md`,
# раздел «Чего этот стек не умеет»).
PHOENIX_WORKER_POLL_INTERVAL_SEC=0.25
PHOENIX_WORKER_BATCH_SIZE=1

# Гонять воркер внутри процесса API (по умолчанию true).
#
# Воркер здесь по умолчанию один, и это следствие требования «аудио не сохраняется»:
# байты принятого чанка лежат в памяти того процесса, который его принял. Второй
# контейнер воркера увидит задание в БД, но не найдёт байтов и пометит его
# `expired` — тихая потеря наблюдения. Чтобы масштабировать обработку, очередь
# нужно сначала вынести в общее хранилище, и только потом отключать эту опцию.
PHOENIX_INLINE_WORKER=true
PHOENIX_INLINE_WORKER_ID=inline-1

# Доля перекрытия, при которой детекция считается дублем (0.5 = половина окна).
PHOENIX_DEDUP_OVERLAP_FRAC=0.5


# --- Мониторинг разрывов связи --------------------------------------------------

# Молчание дольше этого — разрыв наблюдения (внимание: порог по умолчанию
# поднимается до 1.5 x интервала устройства).
PHOENIX_GAP_ALERT_SEC=180

PHOENIX_GAP_MONITOR_INTERVAL_SEC=60

# Текстовый журнал алертов. Даже с webhook его стоит вести: он переживает потерю
# связи с мессенджером, и разбор «когда замолчал микрофон» идёт по нему.
PHOENIX_ALERT_LOG=./server/data/alerts.log

# Webhook для алертов: Telegram-бот, Slack, ntfy. Пусто — выключено.
PHOENIX_ALERT_WEBHOOK=


# --- Отладка (P2) ---------------------------------------------------------------
# Отладочный ПРОТОКОЛ с сохранением аудио — единственное место, где байты
# попадают на диск. Включать только на время разбора одного инцидента:
# файлы переживают перезапуск контейнера и утекают вместе с бэкапом.

PHOENIX_DEBUG_KEEP_AUDIO=false
PHOENIX_DEBUG_KEEP_LAST_CHUNKS=5
PHOENIX_DEBUG_KEEP_TTL_SEC=300